# The Pier tunnel: `pierd relay serve --public` on port 443, as a system service of its own user with no other
# privilege than binding that port. deploy.sh installs it; docs/PROTOCOL.md §10 says what it carries.
[Unit]
Description=Pier tunnel (pierd relay)
After=network-online.target
Wants=network-online.target

[Service]
User=pier
Group=pier
Environment=PIER_HOME=/var/lib/pier
ExecStart=/usr/local/bin/pierd relay serve --listen :443 --public
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/pier
StateDirectory=pier
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
