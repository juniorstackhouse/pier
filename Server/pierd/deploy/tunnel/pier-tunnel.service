# The Pier tunnel: `pierd relay serve --public`, as a system service of its own user with no other privilege than
# binding port 443. deploy.sh installs it; docs/PROTOCOL.md §10 says what it carries.
[Unit]
Description=Pier tunnel (pierd relay)
After=network-online.target
Wants=network-online.target

[Service]
User=pier
Group=pier
Environment=PIER_HOME=/var/lib/pier
# Port 443 to the internet by default; behind a Cloudflare Tunnel, /etc/default/pier-tunnel says
# PIER_TUNNEL_ARGS="--listen 127.0.0.1:7443 --public --behind-proxy" (deploy.sh --cloudflared writes it).
Environment=PIER_TUNNEL_ARGS="--listen :443 --public"
EnvironmentFile=-/etc/default/pier-tunnel
ExecStart=/usr/local/bin/pierd relay serve $PIER_TUNNEL_ARGS
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/pier
StateDirectory=pier
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
